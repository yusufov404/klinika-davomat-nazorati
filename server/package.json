{
  "name": "klinika-attendance-server",
  "version": "1.0.0",
  "private": true,
  "description": "Klinika xodimlari davomat nazorati tizimi - backend",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/create-admin.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/attendance.js",
    "dev:local": "node scripts/dev-local.js",
    "lint": "eslint src scripts tests --max-warnings 0",
    "lint:fix": "eslint src scripts tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "base32.js": "^0.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "^1.64.1",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.2",
    "wait-on": "^9.5.1"
  }
}

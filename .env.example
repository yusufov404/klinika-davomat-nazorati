# ============================================================
#  Klinika davomat nazorati tizimi - sozlamalar
#  Nusxalang:  cp .env.example .env  va to'ldiring
# ============================================================

# ---------- Umumiy ----------
NODE_ENV=production
TZ=Asia/Tashkent
PORT=3000
HOST=0.0.0.0

# Terminal push eventlari yuboriladigan manzil (server IP'si)
PUBLIC_URL=http://192.168.50.2:3000

# ---------- Ma'lumotlar bazasi ----------
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_HOST=db
DB_PORT=5432
# DATABASE_URL=postgres://attendance:CHANGE_THIS_PASSWORD@db:5432/attendance
DB_LOGGING=false

# ---------- JWT ----------
# openssl rand -hex 48  -> yangi kalit
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Terminal parollari shifrlash ----------
# openssl rand -hex 32  -> 64 ta hex belgi (AES-256-GCM)
# DIQQAT: bu kalitni o'zgartirsangiz, bazadagi terminal parollari ochilmaydi!
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# ---------- Terminallar ----------
# Push eventlar uchun maxfiy token (terminalga ham shu qiymat beriladi)
TERMINAL_EVENT_TOKEN=CHANGE_ME_EVENT_TOKEN
# Ruxsat etilgan terminallar IP ro'yxati (vergul bilan)
TERMINAL_IP_ALLOWLIST=192.168.50.11,192.168.50.12,192.168.50.13,192.168.50.14
# Qabul qilinadigan event turlari (AccessControllerEvent / yuz)
TERMINAL_ACCEPT_MAJOR=5
TERMINAL_ACCEPT_MINOR=75
TERMINAL_ALLOW_CARD_EVENTS=true
TERMINAL_HTTP_TIMEOUT=10000

# ---------- Davomat hisoblash ----------
ATTENDANCE_DEBOUNCE_SECONDS=60
ATTENDANCE_WINDOW_BEFORE_HOURS=3
ATTENDANCE_WINDOW_AFTER_HOURS=3
# true = to'liq kechikish, false = faqat grace oshgan qismi
ATTENDANCE_LATE_COUNTS_FULL_GRACE=true

# ---------- Job'lar ----------
JOBS_ENABLED=true
JOB_RECONCILE_CRON=*/5 * * * *
JOB_RECONCILE_LOOKBACK_HOURS=2
JOB_NIGHTLY_RECONCILE_CRON=0 2 * * *
JOB_NIGHTLY_RECONCILE_LOOKBACK_HOURS=24
JOB_CALCULATE_CRON=*/10 * * * *
JOB_TIMESHEET_CRON=10 1 1 * *
JOB_HEALTH_CRON=*/1 * * * *
JOB_SYNC_CRON=*/2 * * * *
JOB_ERROR_CLEANUP_CRON=0 4 * * 0
JOB_TIMEZONE=Asia/Tashkent

# ---------- Bildirishnomalar ----------
# Kunlik hisobot yuborish vaqti (cron)
NOTIFY_DAILY_SUMMARY_CRON=30 18 * * *
# Telegram va qolgan sozlamalar admin panel orqali boshqariladi:
#   telegram.enabled / telegram.botToken / telegram.chatId
#   notify.dailySummary / notify.terminalOffline / notify.leaveRequest

# ---------- Backup ----------
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14

# ---------- Boshqalar ----------
LOG_LEVEL=info
# production uchun "json" (log agregatorlar uchun), default — oddiy format
LOG_FORMAT=
TRUST_PROXY=1
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
MAX_FACE_SIZE_MB=5

# ---------- Admin foydalanuvchi (seed uchun) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
# "adminka" — admin bilan bir xil to'liq huquqli ikkinchi hisob
ADMINKA_PASSWORD=CHANGE_THIS_ADMINKA_PASSWORD
# "glavniy_vrach" — ko'rish va tasdiqlash huquqlari bilan
GLAVNIY_VRACH_PASSWORD=CHANGE_THIS_VRACH_PASSWORD
